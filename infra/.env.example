# Modelo de configuração da sua instância. Copie para infra/.env e preencha o que quiser mudar.
# O .env nunca entra no Git. Chave vazia usa o padrão indicado no comentário.
#
# Segredos da instância (senha do banco e chave mestra) NÃO ficam aqui:
# rode ./init-secrets.sh para criá-los em infra/secrets/ (também fora do Git).

# Fuso usado em datas e relatórios (padrão: America/Sao_Paulo)
TZ=

# Banco de dados (padrões: granapaca e granapaca)
POSTGRES_DB=
POSTGRES_USER=

# Pluggy: crie a sua conta e use as suas próprias credenciais.
# Se ficarem vazias, a instância sobe em modo Sintético (dados fictícios para teste local).
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
