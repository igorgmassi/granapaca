# Modelo de configuração da sua instância. Copie para infra/.env e preencha.
# O .env nunca entra no Git. Chave vazia usa o padrão indicado no comentário.

# Fuso usado em datas e relatórios (padrão: America/Sao_Paulo)
TZ=

# Banco de dados (padrões: granapaca e granapaca)
POSTGRES_DB=
POSTGRES_USER=
# Obrigatória: sem ela, o compose não sobe. Gere com: openssl rand -hex 32
POSTGRES_PASSWORD=

# Chave mestra da criptografia de campo, guardada fora do banco (Docker secret). Ainda não usada.
GRANAPACA_MASTER_KEY_FILE=

# Pluggy: crie a sua conta e use as suas próprias credenciais. Ainda não usadas.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
