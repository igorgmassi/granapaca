{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://granapaca.org/schemas/profile.schema.json",
  "title": "GranaPaCa Onboarding Profile",
  "description": "Schema for YAML profiles that generate initial essentiality and brand rules during onboarding (RF-08).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "group", "label", "description", "rules"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique kebab-case profile identifier matching the YAML filename.",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 60
    },
    "group": {
      "type": "string",
      "description": "Onboarding question group.",
      "enum": ["occupation", "home", "transport"]
    },
    "label": {
      "type": "string",
      "description": "Short pt-BR label displayed in the onboarding UI.",
      "minLength": 2,
      "maxLength": 60
    },
    "description": {
      "type": "string",
      "description": "Short pt-BR description of who fits this profile.",
      "minLength": 10,
      "maxLength": 200
    },
    "rules": {
      "type": "array",
      "description": "Non-empty list of classification rules generated by this profile.",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "explanation", "essentiality", "match"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Globally unique kebab-case rule identifier across all profiles.",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "minLength": 3,
            "maxLength": 80
          },
          "name": {
            "type": "string",
            "description": "Short pt-BR name for the rule.",
            "minLength": 2,
            "maxLength": 80
          },
          "explanation": {
            "type": "string",
            "description": "Short, empathetic, judgment-free pt-BR explanation shown to the user.",
            "minLength": 10,
            "maxLength": 220
          },
          "essentiality": {
            "type": "string",
            "description": "Judgment-free essentiality level (Essencial, Importante, Flexivel).",
            "enum": ["essential", "important", "flexible"]
          },
          "brand": {
            "type": "string",
            "description": "Optional pt-BR tag/brand applied alongside essentiality (e.g., Trabalho, Estudo, Casa).",
            "minLength": 2,
            "maxLength": 40
          },
          "match": {
            "type": "object",
            "description": "Criteria used by the deterministic rule engine to match transactions.",
            "additionalProperties": false,
            "minProperties": 1,
            "anyOf": [
              { "required": ["categories"] },
              { "required": ["keywords"] }
            ],
            "properties": {
              "categories": {
                "type": "array",
                "description": "Normalized category IDs matched by this rule.",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "housing",
                    "food",
                    "transport",
                    "health",
                    "education",
                    "leisure",
                    "shopping",
                    "services",
                    "other"
                  ]
                }
              },
              "keywords": {
                "type": "array",
                "description": "Normalized lowercase merchant/description keywords matched by this rule.",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 60
                }
              }
            }
          }
        }
      }
    }
  }
}
