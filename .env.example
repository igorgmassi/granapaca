# Modelo de configuração da sua instância. Copie para .env e preencha.
# O .env nunca entra no Git. Esta lista é provisória e cresce na Fase 0.
# O backend não sobe sem chave mestra e sem senha forte do banco.

# Fuso usado em datas e relatórios
TZ=America/Sao_Paulo

# Banco de dados
POSTGRES_DB=granapaca
POSTGRES_USER=granapaca
POSTGRES_PASSWORD=

# Chave mestra da criptografia de campo, guardada fora do banco (Docker secret)
GRANAPACA_MASTER_KEY_FILE=./secrets/master.key

# Pluggy: crie a sua conta e use as suas próprias credenciais
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
